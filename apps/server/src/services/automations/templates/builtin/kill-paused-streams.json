{
  "schemaVersion": 1,
  "slug": "kill-paused-streams",
  "name": "Stop paused streams",
  "description": "Stop a stream that has sat paused past the minutes you allow.",
  "group": "housekeeping",
  "kind": "notification",
  "minServerVersion": "2.2.0",
  "inputs": [
    {
      "key": "minutes",
      "kind": "duration",
      "unit": "minutes",
      "label": "Minutes paused",
      "required": false,
      "default": 30,
      "min": 1,
      "max": 1440
    },
    {
      "key": "server",
      "kind": "server",
      "label": "Server",
      "required": false
    },
    {
      "key": "message",
      "kind": "text",
      "label": "Message shown to the viewer",
      "required": false,
      "default": "Your stream was stopped because it was paused for too long",
      "maxLength": 500
    }
  ],
  "definition": {
    "kind": "notification",
    "triggers": [
      {
        "id": "1f1c0b6e-9c1a-4b2e-8d7a-000000001701",
        "type": "session.held_for",
        "enabled": true,
        "params": {
          "minutes": {
            "$input": "minutes"
          },
          "measure": "current"
        }
      }
    ],
    "conditions": {
      "groups": []
    },
    "actions": {
      "actions": [
        {
          "id": "1f1c0b6e-9c1a-4b2e-8d7a-000000001702",
          "type": "kill_stream",
          "enabled": true,
          "message": {
            "$input": "message"
          }
        }
      ]
    },
    "scope": {
      "serverId": {
        "$input": "server"
      }
    }
  },
  "fingerprint": "4185ac7776082373850793c72d43d34252590d9d6c51fb5ca0ded0f1469b792c"
}
